# IBM watsonx Orchestrate API Key
ORCHESTRATE_API_KEY=your_orchestrate_api_key_here

# IBM Instana Agent Key
INSTANA_AGENT_KEY=your_instana_agent_key_here

# Compliance AI API Key
COMPLIANCE_AI_API_KEY=your_ai_api_key_here

# Compliance AI Endpoint
COMPLIANCE_AI_ENDPOINT=https://your-ai-endpoint.com/v1/explain

# High Risk Countries (comma-separated ISO codes)
COMPLIANCE_HIGH_RISK_COUNTRIES=IR,KP,SY,CU,SD,MM,LY,SO,YE,AF

# JWT Secret for Authentication (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here_minimum_256_bits

# Database credentials (if using database)
# DB_USERNAME=your_db_username
# DB_PASSWORD=your_db_password
# DB_URL=jdbc:postgresql://localhost:5432/complianceguard